#!/usr/bin/env python3
"""chess - command-line client for the Chess Gauntlet arena.

  chess games                 list the four games and their status
  chess start <slot>          start a game (one at a time, each only once)
  chess show <slot>           board, FEN, history and legal moves
  chess move <slot> <move>    play a move (SAN: Nf3, O-O, exd8=Q / UCI: g1f3)
  chess resign <slot>         resign a game (counts as a loss)
  chess json <slot>           raw JSON state

The arena URL is taken from $ARENA_URL, otherwise http://127.0.0.1:8000 or
http://chess-arena:8000 is used.
"""
import json
import os
import sys
import urllib.error
import urllib.request

CANDIDATES = [os.environ.get("ARENA_URL", ""), "http://127.0.0.1:8000", "http://chess-arena:8000"]


def request(path, body=None, post=False):
    last = None
    for base in filter(None, CANDIDATES):
        data = json.dumps(body).encode() if body is not None else (b"" if post else None)
        req = urllib.request.Request(base + path, data=data, headers={"Content-Type": "application/json"},
                                     method="POST" if post else "GET")
        try:
            with urllib.request.urlopen(req, timeout=120) as r:
                return json.loads(r.read())
        except urllib.error.HTTPError as e:
            return json.loads(e.read())
        except OSError as e:
            last = e
    sys.exit(f"cannot reach the chess arena ({last})")


def show(st):
    if "error" in st:
        print("ERROR:", st["error"])
        sys.exit(1)
    print(f"Game {st['slot']} vs {st['opponent']} (level {st['opponent_level']}) - you are {st['your_color']}")
    print(st["board"])
    print("FEN:", st["fen"])
    print("Moves:", st["move_history"] or "(none)")
    if st["last_opponent_move"]:
        print("Opponent's last move:", st["last_opponent_move"])
    if st["status"] == "finished":
        print(f"GAME OVER: {st['result']} - you {st['your_outcome']} ({st['termination']})")
    else:
        print("Status:", st["status"], "| in check" if st["in_check"] else "",
              "| YOUR TURN" if st["your_turn"] else "")
        print("Legal moves:", " ".join(st["legal_moves"]))
        print("Plies until move limit:", st["plies_until_move_limit"])


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd, args = argv[1], argv[2:]
    if cmd == "games":
        ov = request("/api/games")
        for g in ov["games"]:
            res = f" {g['result']} ({g['your_outcome']})" if g["result"] else ""
            print(f"[{g['slot']}] vs {g['opponent']:8} (level {g['opponent_level']}) you play {g['your_color']:5} - {g['status']}{res}")
        print("Rules:", json.dumps(ov["rules"]))
    elif cmd in ("start", "show", "resign", "json") and len(args) == 1:
        if cmd == "start":
            show(request(f"/api/games/{args[0]}/start", post=True))
        elif cmd == "resign":
            show(request(f"/api/games/{args[0]}/resign", post=True))
        elif cmd == "json":
            print(json.dumps(request(f"/api/games/{args[0]}"), indent=2))
        else:
            show(request(f"/api/games/{args[0]}"))
    elif cmd == "move" and len(args) == 2:
        show(request(f"/api/games/{args[0]}/move", {"move": args[1]}, post=True))
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
